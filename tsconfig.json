{
  "compilerOptions": {
    "target": "es6",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
